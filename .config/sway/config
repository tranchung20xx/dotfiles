# 69-input-settings.conf
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    pointer_accel 0.5
}

input type:keyboard {
    xkb_layout us
    repeat_rate 100
    repeat_delay 300
}

input type:pointer {
    accel_profile adaptive
    scroll_factor 1.5
    # pointer_accel 0
}

input type:tablet_tool {
    # center align 4:3 tablet to 16:10 screen
    map_from_region 0x0.0833 1x0.9167
}

# xp pen gs403 star
input "10429:2323:Hanvon_ugee_4_inch_PenTablet_Pen" {
    # left_handed enabled
}

# 81-float-this-window.conf
### tOTALLY ai sLops

for_window [window_role="^(pop-up|task_dialog|dialog|utility|Preferences|About|Open|Save|Properties|Confirmation|Print|Page Setup|File Operation Progress)$"] floating enable
for_window [window_role="(?i).*(picker|chooser|selector).*"] floating enable

for_window [app_id="pcmanfm" title=".*Progress.*"] floating enable
for_window [app_id="pcmanfm" title=".*Confirm.*"] floating enable
for_window [app_id="pcmanfm" title=".*Error.*"] floating enable
for_window [app_id="pcmanfm" title="^Properties$"] floating enable
for_window [app_id="pcmanfm" window_role="pcmanfm-preferences"] floating enable

for_window [app_id="localsend"] floating enable

for_window [window_role="^(plugin-window|toolbox|color_chooser|file_chooser)$"] floating enable

# Catch any child/transient window (dialogs, popups, etc.) regardless of app
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="menu"] floating enable

# Archive manager windows
for_window [app_id="xarchiver"] floating enable

# 95-pic-in-picture.conf
# Picture in picture setting for swaywm
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [window_role="PictureInPicture"] floating enable, sticky enable

# 99-screenshot-mode.conf
# Dependency: https://github.com/coffeeispower/woomer
bindsym $mod+x exec ~/.local/bin/woomer

set $name $(date +%Y-%m-%d_%H-%M-%S)
set $var GRIMSHOT_FILENAME_FORMAT
set $grimshot grimshot --notify
mode "screenshot" {
    bindsym c       exec $var=$name $grimshot savecopy area; mode "default"
    bindsym a       exec $var=$name $grimshot save area    ; mode "default"
    bindsym o       exec $var=$name $grimshot save output  ; mode "default"
    bindsym w       exec $var=$name $grimshot save active  ; mode "default"
    bindsym Shift+w exec $var=$name $grimshot save window  ; mode "default"
    bindsym s       exec $var=$name $grimshot save         ; mode "default"
    bindsym Escape mode "default"
    bindsym $mod+s mode "default"
}
bindsym $mod+s mode "screenshot"

